# Local development configuration
# Set USE_LOCAL_DB=true to store applications locally in .data/applications.json
# Set USE_LOCAL_DB=false (or omit) when running against Google Cloud Firestore
USE_LOCAL_DB=true

# Recruiter Admin Dashboard password
ADMIN_PASSWORD=admin123

# Branding customization
NEXT_PUBLIC_BRAND_NAME=TalentTrack
NEXT_PUBLIC_BRAND_TAGLINE=Candidate Application Portal
NEXT_PUBLIC_SUPPORT_EMAIL=careers@talenttrack.example.com

# Optional Firestore overrides
# FIRESTORE_COLLECTION=applications
# FIRESTORE_DATABASE_ID=(default)
